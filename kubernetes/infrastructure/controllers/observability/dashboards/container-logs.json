{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "tags": ["logs", "homelab"],
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "namespace",
        "label": "Namespace",
        "datasource": { "type": "loki", "uid": "loki" },
        "definition": "label_values(k8s_namespace_name)",
        "query": "label_values(k8s_namespace_name)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "type": "query",
        "name": "pod",
        "label": "Pod",
        "datasource": { "type": "loki", "uid": "loki" },
        "definition": "label_values({k8s_namespace_name=~\"$namespace\"}, k8s_pod_name)",
        "query": "label_values({k8s_namespace_name=~\"$namespace\"}, k8s_pod_name)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "type": "query",
        "name": "container",
        "label": "Container",
        "datasource": { "type": "loki", "uid": "loki" },
        "definition": "label_values({k8s_namespace_name=~\"$namespace\", k8s_pod_name=~\"$pod\"}, k8s_container_name)",
        "query": "label_values({k8s_namespace_name=~\"$namespace\", k8s_pod_name=~\"$pod\"}, k8s_container_name)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "type": "textbox",
        "name": "search",
        "label": "Search (regex)",
        "query": "",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    {
      "title": "Log volume by namespace",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (k8s_namespace_name) (count_over_time({k8s_namespace_name=~\"$namespace\", k8s_pod_name=~\"$pod\", k8s_container_name=~\"$container\"} |~ \"(?i)$search\" [$__auto]))",
          "legendFormat": "{{k8s_namespace_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Container logs",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 22, "w": 24, "x": 0, "y": 6 },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{k8s_namespace_name=~\"$namespace\", k8s_pod_name=~\"$pod\", k8s_container_name=~\"$container\"} |~ \"(?i)$search\"",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["logs", "homelab"],
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "",
  "title": "Container Logs (All)",
  "uid": "container-logs-all",
  "version": 1
}
