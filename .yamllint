extends: default

ignore: |
  # OpenTofu init caches (provider binaries, vendored module sources) —
  # not our code, not subject to our formatting rules.
  tofu/**/.terraform/
  # SOPS-encrypted files are machine-generated (the #ENC[...] comment lines have
  # no leading space and trip the comments rule); they are never hand-formatted.
  **/*.sops.yaml
  # Generated Talos/Kubernetes client config output (gitignored, machine-written).
  kubeconfig*.yaml
  talosconfig*.yaml
  # Regenerated verbatim by `flux bootstrap`/`flux install` — never hand-edited.
  **/gotk-components.yaml
  # Vendored upstream Gateway API CRD manifest (chart template content, not ours).
  tofu/**/charts/**
  # Vendored Envoy Gateway CRDs, rendered from gateway-crds-helm (chart template
  # content, not ours — same machine-generated rationale as the tofu gateway-api CRDs).
  kubernetes/**/aigateway-envoy-gateway/envoy-crds.yaml
  # Vendored Agent Sandbox release manifests (Cilium CRD templates etc.) — fetched
  # verbatim from kubernetes-sigs/agent-sandbox and never hand-formatted, so they
  # trip yamllint's indentation rules. Overlays that DO follow repo style live in
  # agent-sandbox/ above the upstream/ dir and remain linted.
  kubernetes/infrastructure/home/agent-sandbox/upstream/**
  # Untracked feature worktree (feature/splithorizondns/) — a scratch copy of
  # the repo used for split-horizon DNS experiments, including a verbatim copy
  # of the vendored agent-sandbox upstream manifests. Same never-hand-formatted
  # rationale as the ignore above; its own state is the user's working tree.
  feature/**

rules:
  line-length:
    max: 120
    allow-non-breakable-words: true
    allow-non-breakable-inline-mappings: true
  document-start: disable
  comments:
    # Disable comments indentation rules to allow easier commenting out of yaml code blocks
    level: warning
  comments-indentation: disable
  truthy: disable
