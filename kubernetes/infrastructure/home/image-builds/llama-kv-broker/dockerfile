# llama-kv-broker — the per-session KV slot broker in front of the qwen36-35b
# llama.cpp server (see llmkube-models/kv-broker.yaml for how it is run).
#
# WHY IT RUNS AS ROOT — the broker mounts the same NFS-backed slot directory the
# serving container writes as uid 0 (`--slot-save-path /var/lib/llama/kv`, pod
# fsGroup 102). That directory is root-owned, so a non-root broker could neither
# create nor unlink the slot files it manages. The process holds no other
# privilege: the pod drops every capability and denies privilege escalation.
#
# WHY golang:1.27-alpine — the newest stable Go line, so the broker is not built
# by a toolchain older than the one the cluster's other Go work uses. The module
# declares `go 1.22` (nothing newer is used) and GOTOOLCHAIN=local keeps the build
# from ever fetching a different toolchain, so the image resolves entirely from
# the pinned public tags below.
#
# BUILD SHAPE — the context is THIS REPO at the commit pinned in the Job
# (`--opt=context=https://github.com/ngoldack/homelab.git#<sha>` plus
# `--opt=filename=.../llama-kv-broker/dockerfile`), the same shape as
# hermes-agent-sandbox-plugin.yaml. COPY sources are therefore REPO-relative and
# resolve against the repo root. Stdlib only: no vendor directory, no go.sum. The
# unit tests are committed next to the sources but deliberately not built here —
# they guard the transaction contract on a developer machine.
FROM golang:1.27-alpine AS build
ENV GOTOOLCHAIN=local CGO_ENABLED=0
WORKDIR /src
COPY kubernetes/infrastructure/home/image-builds/llama-kv-broker/main.go ./
COPY kubernetes/infrastructure/home/image-builds/llama-kv-broker/go.mod ./
# A single static binary; -trimpath and -s -w keep build paths and symbols out of
# the runtime layer.
RUN go build -trimpath -ldflags="-s -w" -o /out/kv-broker .

# Explicit tag (never :latest, which the cluster's Kyverno policies reject); the
# deployed digest is pinned in llmkube-models/kv-broker.yaml.
FROM alpine:3.21
COPY --from=build /out/kv-broker /kv-broker
ENTRYPOINT ["/kv-broker"]
