extends: default

ignore: |
  # OpenTofu init caches (provider binaries, vendored module sources) —
  # not our code, not subject to our formatting rules.
  tofu/**/.terraform/
  # SOPS-encrypted files are machine-generated (the #ENC[...] comment lines have
  # no leading space and trip the comments rule); they are never hand-formatted.
  **/*.sops.yaml
  # Generated Talos/Kubernetes client config output (gitignored, machine-written).
  kubeconfig*.yaml
  talosconfig*.yaml

rules:
  line-length:
    max: 120
    allow-non-breakable-words: true
    allow-non-breakable-inline-mappings: true
  document-start: disable
  comments:
    # Disable comments indentation rules to allow easier commenting out of yaml code blocks
    level: warning
  comments-indentation: disable
  truthy: disable
