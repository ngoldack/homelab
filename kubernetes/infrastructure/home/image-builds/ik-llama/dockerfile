# ik_llama.cpp llama-server for the P100 — vendored build file.
#
# Based on ik's .devops/llama-server-cuda.Dockerfile at the commit pinned by the
# build Job (--opt=context), with ONE addition: the sm_60 fast-FP16 precision
# carve-out (llama.cpp#25593; TheTom/llama-cpp-turboquant tqp-v0.3.0).
#
# WHY: llama.cpp/ik route Pascal's fp16-capable arches (>= 600) onto the fast-FP16
# math path, exempting only sm_61. The P100 (sm_60) has genuine HFMA2 fast-FP16
# hardware, but llama.cpp's fp16 vector accumulation produces silent numerical
# noise there (median KLD 0.0023 vs 1e-6 patched; top-token agreement 96.5% vs
# 99.9%). ik 3bb386e already routes FA *decode* to fp32 on P100 (fattn.cu P100
# carve-out, "decode is bandwidth-bound so vec_f32 is free"), so decode quality
# and speed are unaffected. The two lines below close the residual fp16 paths:
#   - FA *prefill* (tile kernel, batch > 8) on P100 — fp32 accumulation
#   - MMQ half2 scale math (runs on P100 only for MoE experts — qwen35moe track)
# Zero expected tg change; free accuracy. Build breakage risk is nil: the carved
# sm_60 path is preprocessor-identical to the long-proven sm_61 path.
#
# This file reaches buildkit via --local dockerfile= (dockerfilekey=dockerfile in
# the Job), NOT via the remote git context — so only this file is ours to maintain.
ARG UBUNTU_VERSION=22.04
ARG CUDA_VERSION=12.4.1
ARG BASE_CUDA_DEV_CONTAINER=nvidia/cuda:${CUDA_VERSION}-devel-ubuntu${UBUNTU_VERSION}
ARG BASE_CUDA_RUN_CONTAINER=nvidia/cuda:${CUDA_VERSION}-runtime-ubuntu${UBUNTU_VERSION}

FROM ${BASE_CUDA_DEV_CONTAINER} AS build

# Set targeted arch here as needed, default: 86 (Ampere) and 90 (Hopper)
ARG CUDA_DOCKER_ARCH="86;90"

RUN apt-get update && \
    apt-get install -y build-essential git libcurl4-openssl-dev ninja-build python3-pip \
 && pip3 install --no-cache-dir cmake \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY . .

# sm_60 fast-FP16 carve-out. Line numbers are stable because the context is
# pinned to one commit; the greps fail the build if the seds miss their target.
#   common.cuh:153  #if defined(FP16_AVAILABLE) && __CUDA_ARCH__ != 610
#   common.cuh:209  return cc >= CC_PASCAL && cc != 610;
RUN sed -i \
      -e '153s/!= 610/!= 610 \&\& __CUDA_ARCH__ != 600/' \
      -e '209s/cc != 610;/cc != 610 \&\& cc != 600;/' \
      ggml/src/ggml-cuda/common.cuh \
 && grep -q '__CUDA_ARCH__ != 610 && __CUDA_ARCH__ != 600' ggml/src/ggml-cuda/common.cuh \
 && grep -q 'cc >= CC_PASCAL && cc != 610 && cc != 600' ggml/src/ggml-cuda/common.cuh

# Set nvcc architecture
ENV CUDA_DOCKER_ARCH=${CUDA_DOCKER_ARCH}
# Enable CUDA
ENV GGML_CUDA=1
# Enable cURL
ENV LLAMA_CURL=1
# Must be set to 0.0.0.0 so it can listen to requests from host machine
ENV LLAMA_ARG_HOST=0.0.0.0

RUN cmake -S . -B build -G Ninja \
    -DGGML_CUDA=ON -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_CUDA_ARCHITECTURES="${CUDA_DOCKER_ARCH}" \
    -DBUILD_SHARED_LIBS=ON \
    -DCMAKE_C_FLAGS="-fPIC -mcmodel=large" \
    -DCMAKE_CXX_FLAGS="-fPIC -mcmodel=large" \
 && cmake --build build --target llama-server

FROM ${BASE_CUDA_RUN_CONTAINER} AS runtime

RUN apt-get update && \
    apt-get install -y libcurl4-openssl-dev libgomp1 curl

COPY --from=build /app/build/bin/llama-server /llama-server

COPY --from=build /app/build/examples/mtmd/libmtmd.so /usr/local/lib/
COPY --from=build /app/build/ggml/src/libggml.so /usr/local/lib/
COPY --from=build /app/build/src/libllama.so /usr/local/lib/
RUN ldconfig

HEALTHCHECK CMD [ "curl", "-f", "http://localhost:8080/health" ]

ENTRYPOINT [ "/llama-server" ]
