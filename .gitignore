# Age private keys - never commit these
age.key
*.age.key

# Explicit plaintext SOPS working copies. Encrypted sources always use the
# .sops.yaml suffix and remain safe to commit.
*.local.yaml
*.local.yml

# OpenTofu state and lock files
# State itself is NOT tracked in Git. It is stored locally and encrypted with
# OpenTofu's native state encryption. Only the provider lock file is committed.
tofu/.terraform/
tofu/terraform.tfstate
tofu/terraform.tfstate.backup
tofu/*/.terraform/
tofu/*/terraform.tfstate
tofu/*/terraform.tfstate.backup
# OpenTofu's numeric-suffixed "state was rewritten" backups
# (terraform.tfstate.<unix-timestamp>.backup), same encrypted-state risk as
# the plain .backup file above.
tofu/terraform.tfstate.*.backup
tofu/*/terraform.tfstate.*.backup
# Dated local-state snapshots kept outside tofu/ across a full teardown/
# rebuild — same encrypted-state risk as the backups above.
.state-archive/
# The provider lock file IS committed so CI validates against pinned versions.
!tofu/*/.terraform.lock.hcl

# OpenTofu plan files may contain secrets (even though plan encryption is enabled,
# avoid committing them by accident)
tofu/**/*.tfplan
*.tfplan

# tfvars files may contain plaintext secrets
tofu/**/*.tfvars
tofu/**/*.tfvars.json
!tofu/*/terraform.tfvars

# Environment files used for SOPS/encryption passphrases
.env
.env.*

# Generated kubeconfig and talosconfig outputs
kubeconfig
talosconfig
kubeconfig.yaml
talosconfig.yaml
kubeconfig-home.yaml
kubeconfig-cloud.yaml
talosconfig-home.yaml
talosconfig-cloud.yaml
*.kubeconfig
*.talosconfig
*.kubeconfig.yaml
*.talosconfig.yaml

# mktemp working files from the Taskfile's write-temp-then-mv pattern. These
# carry a random suffix appended AFTER the extension
# (kubeconfig-home.yaml.tmp.hK3p9x, cluster-secrets.local.yaml.tmp.Qa1Zc4), so
# none of the exact-name or *.local.yaml rules above match them. They hold
# plaintext kubeconfigs and decrypted SOPS output, and Task's embedded shell
# does not run EXIT traps on interrupt — so a Ctrl-C mid-task leaves one behind.
*.tmp.*

# Editor settings (references machine-local absolute paths)
.vscode/
